# ==========================================
# EduVision Environment Configuration
# Copy this file to .env and configure for your environment.
# ==========================================

# PostgreSQL
POSTGRES_USER=eduvision
POSTGRES_PASSWORD=change-me-to-a-long-password
POSTGRES_DB=eduvision
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=4000
NODE_ENV=development
# Public base URL for the API (used in links/emails). In Docker production this is the Nginx domain.
API_URL=http://localhost:4000

# JWT & Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Set to your root domain (e.g. .eduvisionschools.co.za) so cookies work across subdomains.
COOKIE_DOMAIN=localhost

# Storage (local or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=uploads
# Public base URL for uploaded files.
# - Use http://localhost:4000 for local development.
# - In production set to https://yourdomain.com (Nginx will still serve /uploads directly).
STORAGE_BASE_URL=http://localhost:4000
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend
NEXT_PUBLIC_API_URL=
