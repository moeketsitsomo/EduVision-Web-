# Database
DATABASE_URL=postgresql://eduvision:eduvision@localhost:5432/eduvision?schema=public

# API
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000

# JWT & Security
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost

# Storage (local or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=uploads
# Set to public base URL for files; leave empty in production and serve /uploads via Nginx
STORAGE_BASE_URL=http://localhost:4000
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
