generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  SCHOOL_STAFF
  TEACHER
  PARENT
  LEARNER
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum NoticeAudience {
  ALL
  PARENTS
  TEACHERS
  LEARNERS
  STAFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AdmissionStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum PlanType {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

model School {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  customDomain        String?            @unique
  logoUrl             String?
  faviconUrl          String?
  bannerImageUrl      String?
  primaryColor        String?            @default("#2563eb")
  secondaryColor      String?            @default("#1e293b")
  darkMode            Boolean            @default(false)
  contactEmail        String?
  contactPhone        String?
  address             String?
  billingEmail        String?
  admissionsEmail     String?
  admissionsPhone     String?
  websiteTitle        String?
  metaDescription     String?
  footerText          String?
  principalName       String?
  principalMessage    String?
  mission             String?
  vision              String?
  values              String?
  history             String?
  establishedYear     Int?
  enrollmentCount     Int?
  teacherCount        Int?
  classroomCount      Int?
  passRate            Float?
  facilities          Json?
  awards              Json?
  officeHours         String?
  googleMapsUrl       String?
  locationLat         Float?
  locationLng         Float?
  isActive            Boolean            @default(true)
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  trialEndsAt         DateTime?
  plan                PlanType?          @default(BASIC)
  licenseKey          String?            @unique
  maxStorageMb        Int                @default(100)
  maxUsers            Int                @default(50)
  settings            Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  users               User[]
  auditLogs           AuditLog[]
  pages               Page[]
  posts               Post[]
  staff               Staff[]
  events              Event[]
  galleries           Gallery[]
  downloads           Download[]
  media               Media[]
  contacts            EmergencyContact[]
  socials             SocialLink[]
  navigationItems     NavigationItem[]
  fees                SchoolFee[]
  contactMessages     ContactMessage[]
  notices             Notice[]
  admissions          AdmissionApplication[]
  results             Result[]
  attendance          Attendance[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  licenses            License[]
  students            Student[]
  passwordResetTokens PasswordResetToken[]
  timetable           TimetableEntry[]
  books               Book[]
  borrowings          Borrowing[]
  financeTransactions FinanceTransaction[]
  communications      Communication[]
  reports             Report[]
  subjects            Subject[]
  homework            Homework[]

  @@index([slug])
  @@index([customDomain])
  @@index([isActive])
  @@index([subscriptionStatus])
  @@index([trialEndsAt])
}

model User {
  id                  String    @id @default(cuid())
  email               String
  passwordHash        String
  firstName           String?
  lastName            String?
  role                UserRole
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  twoFactorSecret     String?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorBackupCodes Json?

  schoolId            String
  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  studentId           String?
  student             Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)

  auditLogs           AuditLog[]
  media               Media[]

  @@unique([email, schoolId])
  @@index([schoolId])
  @@index([studentId])
  @@index([role])
  @@index([isActive])
}

model Student {
  id           String       @id @default(cuid())
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentNumber String      @unique
  firstName    String
  lastName     String?
  grade        String?
  dateOfBirth  DateTime?
  parentEmail  String?
  parentPhone  String?
  gender       String?
  address      String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users        User[]
  results      Result[]
  attendance   Attendance[]
  homework     Homework[]

  @@unique([schoolId, studentNumber])
  @@index([schoolId])
  @@index([parentEmail])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  userId      String?
  schoolId    String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  school      School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([userId])
  @@index([action, createdAt])
  @@index([entity])
}

model Page {
  id              String   @id @default(cuid())
  slug            String
  title           String
  subtitle        String?
  content         String   @default("")
  bannerImageUrl  String?
  featuredImageUrl String?
  isPublished     Boolean  @default(true)
  showInMenu      Boolean  @default(true)
  menuOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, slug])
  @@index([schoolId, menuOrder])
}

model Post {
  id               String   @id @default(cuid())
  title            String
  slug             String
  summary          String?
  content          String   @default("")
  featuredImageUrl String?
  category         String   @default("news")
  isPublished      Boolean  @default(true)
  publishedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, slug])
  @@index([schoolId, category, publishedAt])
}

model Staff {
  id          String   @id @default(cuid())
  name        String
  role        String
  department  String?
  bio         String?
  email       String?
  phone       String?
  photoUrl    String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, order])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean  @default(false)
  location    String?
  imageUrl    String?
  category    String?  @default("general")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, startAt])
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverImageUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items       GalleryItem[]

  @@index([schoolId])
}

model GalleryItem {
  id       String  @id @default(cuid())
  caption  String?
  order    Int     @default(0)
  mediaId  String
  media    Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  galleryId String
  gallery  Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, order])
}

model Download {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  fileUrl     String
  mediaId     String?
  media       Media?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, category])
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  type         MediaType
  category     String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  galleryItems  GalleryItem[]
  downloads     Download[]

  @@index([schoolId, type])
  @@index([schoolId, category])
  @@index([uploadedById])
}

model EmergencyContact {
  id       String @id @default(cuid())
  name     String
  number   String
  type     String
  label    String?
  order    Int    @default(0)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, order])
}

model SocialLink {
  id       String @id @default(cuid())
  platform String
  url      String
  order    Int    @default(0)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, order])
}

model SchoolFee {
  id          String   @id @default(cuid())
  grade       String
  item        String
  amount      Decimal
  year        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, year])
}

model NavigationItem {
  id        String  @id @default(cuid())
  label     String
  href      String
  visible   Boolean @default(true)
  order     Int     @default(0)
  isExternal Boolean @default(false)
  pageId    String?
  postId    String?
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, order])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

model Notice {
  id          String        @id @default(cuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  content     String        @default("")
  audience    NoticeAudience @default(ALL)
  isPublished Boolean       @default(true)
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([schoolId, audience, publishedAt])
  @@index([schoolId, isPublished, publishedAt])
}

model AdmissionApplication {
  id              String         @id @default(cuid())
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentFirstName String
  studentLastName String?
  dateOfBirth     DateTime?
  gender          String?
  gradeApplying   String
  previousSchool  String?
  parentName      String
  parentEmail     String
  parentPhone     String?
  address         String?
  status          AdmissionStatus @default(PENDING)
  notes           String?
  documentUrls    Json?
  submittedAt     DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([schoolId, status, submittedAt])
}

model Result {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String?
  student       Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentNumber String?
  academicYear  String
  term          String
  subject       String
  score         Float?
  maxScore      Float    @default(100)
  grade         String?
  remarks       String?
  isPublished   Boolean  @default(false)
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId, studentNumber, academicYear, term])
  @@index([schoolId, studentId, academicYear, term])
  @@index([isPublished])
}

model Attendance {
  id            String           @id @default(cuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String?
  student       Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentNumber String?
  studentName   String?
  grade         String?
  date          DateTime         @db.Date
  status        AttendanceStatus
  reason        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([schoolId, date, status])
  @@index([schoolId, studentNumber, date])
  @@index([studentId])
}

model Subscription {
  id            String             @id @default(cuid())
  schoolId      String             @unique
  school        School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan          PlanType           @default(BASIC)
  status        SubscriptionStatus @default(TRIAL)
  startDate     DateTime?
  endDate       DateTime?
  trialEndsAt   DateTime?
  price         Decimal?
  billingCycle  BillingCycle?
  autoRenew     Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  invoices      Invoice[]

  @@index([schoolId, status])
  @@index([status, endDate])
}

model Invoice {
  id             String        @id @default(cuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount         Decimal
  tax            Decimal       @default(0)
  total          Decimal
  dueDate        DateTime?
  paidAt         DateTime?
  status         InvoiceStatus @default(DRAFT)
  items          Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([schoolId, status, dueDate])
  @@index([schoolId, paidAt])
}

model License {
  id        String             @id @default(cuid())
  schoolId  String             @unique
  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key       String             @unique
  seats     Int                @default(0)
  startDate DateTime?
  endDate   DateTime?
  status    SubscriptionStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
  @@index([endDate])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String
  schoolId  String?
  school    School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, schoolId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model TimetableEntry {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  className   String
  subject     String
  teacherName String
  dayOfWeek   String
  startTime   String
  endTime     String
  room        String?
  term        String?
  year        Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, dayOfWeek])
  @@index([schoolId, className, year])
}

model Book {
  id              String      @id @default(cuid())
  schoolId        String
  school          School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title           String
  author          String?
  isbn            String?
  category        String?
  copiesTotal     Int         @default(1)
  copiesAvailable Int         @default(1)
  publishedYear   Int?
  location        String?
  borrowings      Borrowing[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([schoolId, title])
  @@index([schoolId, isbn])
}

model Borrowing {
  id           String    @id @default(cuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bookId       String
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  borrowerType String
  borrowerName String
  borrowedAt   DateTime  @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([schoolId, returnedAt])
  @@index([bookId])
}

model FinanceTransaction {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Decimal
  type        String
  category    String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, date])
  @@index([schoolId, type])
}

model Communication {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type      String
  audience  String
  subject   String
  content   String
  sentAt    DateTime @default(now())
  status    String   @default("SENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, sentAt])
  @@index([schoolId, type])
}

model Report {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  type        String
  filters     Json?
  fileUrl     String?
  status      String   @default("PENDING")
  generatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, type])
  @@index([schoolId, status])
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  grade       String?
  description String?
  category    String?
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, order])
  @@index([schoolId, grade])
}

model Homework {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  grade       String?
  subject     String
  title       String
  description String?
  fileUrl     String?
  assignedAt  DateTime  @default(now())
  dueDate     DateTime?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, grade])
  @@index([schoolId, studentId])
}
