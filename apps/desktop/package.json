{
  "name": "eduvision-desktop",
  "version": "1.4.0",
  "private": true,
  "description": "EduVision School Website desktop application",
  "homepage": "https://github.com/moeketsitsomo/EduVision-Web-",
  "author": {
    "name": "EduVision",
    "email": "support@eduvision.local"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:desktop": "electron-builder",
    "build:dir": "electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "41.7.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.eduvision.desktop",
    "productName": "EduVision-School-Website",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../apps/api",
        "to": "root/apps/api"
      },
      {
        "from": "../../apps/web",
        "to": "root/apps/web"
      },
      {
        "from": "../../package.json",
        "to": "root/package.json"
      },
      {
        "from": "../../package-lock.json",
        "to": "root/package-lock.json"
      },
      {
        "from": "../../.dockerignore",
        "to": "root/.dockerignore"
      },
      {
        "from": "../../docker-compose.desktop.yml",
        "to": "root/docker-compose.desktop.yml"
      },
      {
        "from": "../../.env.example",
        "to": "root/.env.example"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "executableName": "eduvision-desktop",
      "desktop": {
        "Name": "EduVision School Website",
        "Comment": "Desktop school website application",
        "Categories": "Network;Education;Office;",
        "StartupWMClass": "EduVision-School-Website"
      }
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "EduVision-School-Website-Setup-${version}.${ext}",
      "shortcutName": "EduVision School Website"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
